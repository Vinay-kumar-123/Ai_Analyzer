# ==============================================================================
# AI Learning OS (AiAnalyzer) — Production Git Ignore Rules
# ==============================================================================

# Dependencies (Never commit node_modules)
node_modules/
**/node_modules/
backend/node_modules/
frontend/node_modules/
.pnpm-store/
.yarn/
.npm/

# Environment Variables & Local Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
frontend/.env.local

# Next.js Build & Cache Outputs
frontend/.next/
frontend/out/
.next/
out/

# Production Build Output
dist/
build/
*.tgz
*.tar.gz

# Logs & Runtime Data
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
backend/logs/

# OS & IDE System Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Test & Coverage Artifacts
coverage/
.nyc_output/

# Temporary Scratch Files
tmp/
temp/
